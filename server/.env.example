# Copie este arquivo para server/.env e preencha com suas chaves.
# server/.env está no .gitignore — só ESTE arquivo (.env.example) é
# versionado no Git, então nunca cole chaves reais aqui.

# Ordem da cadeia de fallback entre provedores de IA (todos com camada
# gratuita). O servidor tenta o primeiro; se ele estourar o limite grátis
# (429) ou ficar indisponível, cai pro próximo automaticamente — sem o
# usuário perceber. Só entram na cadeia os provedores com chave definida.
AI_PROVIDER_CHAIN=gemini,groq,mistral

# --- Gemini (Google) — https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
# Modelo primário da geração. Deixe em gemini-2.5-flash: a camada grátis
# costuma dar 404 em gemini-2.5-pro. O -pro é mais forte em design/UI, então
# use-o só se a SUA chave tiver acesso (teste antes). 503 = sobrecarga
# temporária do Google, não é problema de modelo — tente de novo mais tarde.
GEMINI_MODEL=gemini-2.5-flash

# --- Geração multi-passo (opcional) ---
# Cada papel usa o GEMINI_MODEL por padrão. Aponte para outro modelo só se
# quiser (ex.: PLANNER_MODEL=gemini-2.5-flash pra economizar cota no plano).
PLANNER_MODEL=
BUILDER_MODEL=
REVIEWER_MODEL=
# Passo de auto-revisão de UI depois de montar o app (1 rodada, +1 chamada).
# Desligado por padrão (no tier grátis cada chamada extra chega mais perto
# do 429). Ligue quando a chave aguentar.
GENERATE_REVIEW_PASS=false

# --- Groq — https://console.groq.com/keys (camada grátis bem generosa) ---
# Groq troca os IDs com frequência. Se der 404/413, veja os ativos em
# https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Mistral — https://console.mistral.ai/api-keys ("Experiment"/free tier) ---
# mistral-large-latest / mistral-medium exigem plano PAGO (403
# tier_not_allowed). No tier grátis: mistral-small-latest, open-mistral-nemo.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Pexels — https://www.pexels.com/api/ (grátis, sem espera de aprovação) ---
# Usada pra buscar fotos REAIS relacionadas ao assunto de cada imagem.
# Sem essa chave, as imagens caem no picsum.photos (sempre carregam, mas
# são aleatórias, não relacionadas ao conteúdo).
PEXELS_API_KEY=

# --- Claude (Anthropic) — PAGO, fica de fora da cadeia por padrão. ---
# Só é usado se você adicionar "anthropic" manualmente no AI_PROVIDER_CHAIN
# acima (ex.: gemini,groq,mistral,anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
