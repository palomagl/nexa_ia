# Copie este arquivo para .env (dev local) ou configure a mesma variável
# nas Environment Variables do projeto no Vercel (produção).

# URL do backend Express (server/index.js). Em dev local, deixe vazio ou
# aponte pra localhost:3000. Em produção (Vercel), aponte pra onde o
# backend estiver hospedado (ex.: Render) — sem barra no final.
VITE_API_URL=http://localhost:3000
